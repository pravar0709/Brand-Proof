# BrandProof Environment Variables
# Copy to .env and fill in values

# LLM Configuration
LLM_PROVIDER=none          # gemini | anthropic | none
LLM_API_KEY=               # Your API key (leave empty for none)
LLM_MODEL=                 # e.g. gemini-2.0-flash, claude-sonnet-4-20250514

# App Configuration
SECRET_KEY=change-me-to-a-random-string
PORT=8000
